# URL pública/base de la API. Vacío = mismo origen y proxy de Vite en desarrollo.
VITE_API_BASE_URL=

# Modo demostración sin autenticación real. En staging/producción debe ser false.
VITE_USE_MOCKS=true

# No guardar secretos, client secrets ni tokens en variables VITE_*.
VITE_OIDC_AUTHORITY=https://identidad.example.org
VITE_OIDC_CLIENT_ID=pmgm-web
VITE_OIDC_SCOPE=openid profile
