{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BucketListingForNotFoundHead",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::pmgm-documents"]
    },
    {
      "Sid": "AllowDocumentObjectsOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::pmgm-documents/*"]
    }
  ]
}
