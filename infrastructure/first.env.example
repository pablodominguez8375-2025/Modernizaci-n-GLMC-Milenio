# Proyecto Milenio — primera implementación QA/piloto local
# Copiar a infrastructure/.env.first.local si se configura manualmente.
# Los launchers oficiales generan este archivo automáticamente cuando no existe.
# Nunca versionar infrastructure/.env.first.local.

PMGM_FIRST_DB_PASSWORD=REEMPLAZAR_POR_SECRETO_ALEATORIO
PMGM_FIRST_MINIO_USER=pmgmqa
PMGM_FIRST_MINIO_PASSWORD=REEMPLAZAR_POR_SECRETO_ALEATORIO
PMGM_FIRST_KEYCLOAK_ADMIN_PASSWORD=REEMPLAZAR_POR_SECRETO_ALEATORIO
PMGM_QA_USER_PASSWORD=REEMPLAZAR_POR_SECRETO_ALEATORIO

# Alta de usuarios: habilitar sólo después de crear el cliente confidencial de servicio
# con manage-users/view-users en realm-management y configurar correo STARTTLS.
PMGM_ACCOUNT_IDENTITY_URL=
PMGM_ACCOUNT_ISSUER=
PMGM_ACCOUNT_CLIENT_ID=pmgm-account-admin
PMGM_ACCOUNT_CLIENT_SECRET=
PMGM_ACCOUNT_SMTP_HOST=
PMGM_ACCOUNT_SMTP_PORT=587
PMGM_ACCOUNT_SMTP_AUTH=true
PMGM_ACCOUNT_SMTP_USER=
PMGM_ACCOUNT_SMTP_PASSWORD=
PMGM_ACCOUNT_SMTP_FROM=
PMGM_ACCOUNT_LOGIN_URL=
