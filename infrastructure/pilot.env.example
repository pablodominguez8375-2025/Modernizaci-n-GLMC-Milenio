# Proyecto Milenio — perfil de piloto operacional v0.32
# Copiar a infrastructure/.env.pilot.local y reemplazar TODOS los valores de ejemplo.
# Nunca versionar el archivo .env.pilot.local.

PMGM_PILOT_HOSTNAME=piloto.example.cl
PMGM_PILOT_PUBLIC_URL=https://piloto.example.cl
PMGM_PILOT_BIND_ADDRESS=0.0.0.0
PMGM_PILOT_HTTP_PORT=80
PMGM_PILOT_HTTPS_PORT=443
PMGM_PILOT_CADDYFILE=./caddy/Caddyfile.pilot
PMGM_PILOT_ALLOW_LOCALHOST=false
PMGM_PILOT_INSECURE_TLS=false

PMGM_PILOT_DB_PASSWORD=REEMPLAZAR-CON-SECRETO-ALEATORIO-DB
PMGM_PILOT_MINIO_USER=pmgm-pilot-storage
PMGM_PILOT_MINIO_PASSWORD=REEMPLAZAR-CON-SECRETO-ALEATORIO-MINIO
PMGM_PILOT_KEYCLOAK_ADMIN_USERNAME=pmgm-kc-admin
PMGM_PILOT_KEYCLOAK_ADMIN_PASSWORD=REEMPLAZAR-CON-SECRETO-ALEATORIO-KEYCLOAK

# Primer usuario institucional. La contraseña queda marcada como temporal en Keycloak.
PMGM_PILOT_ADMIN_USERNAME=pilot.admin
PMGM_PILOT_ADMIN_EMAIL=admin-piloto@example.invalid
PMGM_PILOT_ADMIN_PASSWORD=REEMPLAZAR-CON-SECRETO-ALEATORIO-USUARIO

# Alta de usuarios: habilitar sólo después de crear el cliente confidencial de servicio
# con manage-users/view-users en realm-management y configurar correo STARTTLS.
PMGM_ACCOUNT_IDENTITY_URL=
PMGM_ACCOUNT_ISSUER=
PMGM_ACCOUNT_CLIENT_ID=pmgm-account-admin
PMGM_ACCOUNT_CLIENT_SECRET=
PMGM_ACCOUNT_SMTP_HOST=
PMGM_ACCOUNT_SMTP_PORT=587
PMGM_ACCOUNT_SMTP_AUTH=true
PMGM_ACCOUNT_SMTP_USER=
PMGM_ACCOUNT_SMTP_PASSWORD=
PMGM_ACCOUNT_SMTP_FROM=
PMGM_ACCOUNT_LOGIN_URL=
