# Proyecto Centenario — QA glmdch (nombre técnico histórico srv01)
# Copiar fuera del repositorio, idealmente a /etc/pmgm/srv01.env.
# Reemplazar todos los valores REEMPLAZAR_* antes de instalar.

# Perfil HTTPS explícito: true exige URL canónica y /identity; sólo gateway 80/443.
# Mantener false hasta verificar DNS, puertos, host, BD2 y aceptación operativa.
PMGM_QA_HTTPS=false
PMGM_QA_BIND_ADDRESS=127.0.0.1
PMGM_QA_WEB_PORT=8081
PMGM_QA_OIDC_PORT=8180

# DECISIÓN SPONSOR 16-10-2026: dominio público CANÓNICO de QA, SOLO datos sintéticos.
# Esta plantilla NO configura DNS, certificado TLS, Caddy ni proxy; el stack debe permanecer
# en loopback hasta superar las barreras de seguridad y verificar OIDC/HTTPS real.
# Nunca publicar directamente los puertos HTTP 8081/8180 (ni Keycloak/Admin/S3/DB).
PMGM_QA_WEB_PUBLIC_URL=https://sistema.granlogiamixta.cl
# Con PMGM_QA_HTTPS=true, usar https://sistema.granlogiamixta.cl/identity.
# El perfil privado histórico permanece sin /identity; no publicarlo directamente.
# Usar exclusivamente issuer HTTPS real y callbacks del dominio QA; jamás localhost HTTP
# como redirect público. Valor obligatorio; el preflight rechaza REEMPLAZAR_*.
PMGM_QA_OIDC_PUBLIC_URL=REEMPLAZAR_URL_HTTPS_OIDC_VALIDADA

PMGM_QA_DB_PASSWORD=REEMPLAZAR_DB
# Silo 20261015 aprobado sólo para QA por Sponsor (#97/#479, 16-10-2026).
# No autoriza despliegue antes de validar suministro/seguridad/recuperación.
# Estas identidades deben ser todas distintas. No usar contraseñas reales en Git.
PMGM_QA_STORAGE_ADMIN_USER=REEMPLAZAR_STORAGE_ADMIN_USER
PMGM_QA_STORAGE_ADMIN_PASSWORD=REEMPLAZAR_STORAGE_ADMIN_PASSWORD
PMGM_QA_DOCUMENT_ACCESS_KEY=REEMPLAZAR_DOCUMENT_ACCESS_KEY
PMGM_QA_DOCUMENT_SECRET_KEY=REEMPLAZAR_DOCUMENT_SECRET_KEY
PMGM_QA_BACKUP_ACCESS_KEY=REEMPLAZAR_BACKUP_ACCESS_KEY
PMGM_QA_BACKUP_SECRET_KEY=REEMPLAZAR_BACKUP_SECRET_KEY
PMGM_QA_KEYCLOAK_ADMIN_PASSWORD=REEMPLAZAR_KEYCLOAK
PMGM_QA_USER_PASSWORD=REEMPLAZAR_USUARIOS_QA

# Alta de usuarios: habilitar sólo después de crear el cliente confidencial de servicio
# con manage-users/view-users en realm-management y configurar correo STARTTLS.
PMGM_ACCOUNT_IDENTITY_URL=
PMGM_ACCOUNT_ISSUER=
PMGM_ACCOUNT_CLIENT_ID=pmgm-account-admin
PMGM_ACCOUNT_CLIENT_SECRET=
PMGM_ACCOUNT_SMTP_HOST=
PMGM_ACCOUNT_SMTP_PORT=587
PMGM_ACCOUNT_SMTP_AUTH=true
PMGM_ACCOUNT_SMTP_USER=
PMGM_ACCOUNT_SMTP_PASSWORD=
PMGM_ACCOUNT_SMTP_FROM=
PMGM_ACCOUNT_LOGIN_URL=
