# Proyecto Centenario — QA srv01
# Copiar fuera del repositorio, idealmente a /etc/pmgm/srv01.env.
# Reemplazar todos los valores REEMPLAZAR_* antes de instalar.

PMGM_QA_BIND_ADDRESS=0.0.0.0
PMGM_QA_WEB_PORT=8081
PMGM_QA_OIDC_PORT=8180

# Deben ser orígenes alcanzables desde el navegador del equipo que realizará QA.
PMGM_QA_WEB_PUBLIC_URL=http://REEMPLAZAR_HOST_SRV01:8081
PMGM_QA_OIDC_PUBLIC_URL=http://REEMPLAZAR_HOST_SRV01:8180

PMGM_QA_DB_PASSWORD=REEMPLAZAR_DB
PMGM_QA_MINIO_USER=pmgmqa
PMGM_QA_MINIO_PASSWORD=REEMPLAZAR_MINIO
PMGM_QA_KEYCLOAK_ADMIN_PASSWORD=REEMPLAZAR_KEYCLOAK
PMGM_QA_USER_PASSWORD=REEMPLAZAR_USUARIOS_QA
