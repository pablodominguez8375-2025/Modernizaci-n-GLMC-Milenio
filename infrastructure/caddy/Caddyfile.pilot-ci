https://{$PMGM_PILOT_HOSTNAME} {
    tls internal
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "no-referrer"
        -Server
    }

    handle /identity/* {
        # Denegar consola/admin master desde el único punto de entrada HTTPS público.
        @denyIdentityAdmin path /identity/admin /identity/admin/* /identity/realms/master /identity/realms/master/*
        respond @denyIdentityAdmin "Not Found" 404
        reverse_proxy keycloak:8080
    }

    handle {
        reverse_proxy web:80
    }
}
