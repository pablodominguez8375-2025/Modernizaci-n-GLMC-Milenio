https://{$PMGM_PILOT_HOSTNAME} {
    tls internal
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "no-referrer"
        -Server
    }

    handle /identity/* {
        reverse_proxy keycloak:8080
    }

    handle {
        reverse_proxy web:80
    }
}
