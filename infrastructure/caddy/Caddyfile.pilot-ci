https://{$PMGM_PILOT_HOSTNAME} {
    tls internal
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "no-referrer"
        -Server
    }

    handle /identity/* {
        # Denegar consola/admin master desde el único punto de entrada HTTPS público.
        @denyIdentityAdmin path /identity/admin /identity/admin/* /identity/realms/master /identity/realms/master/*
        respond @denyIdentityAdmin "Not Found" 404
        reverse_proxy keycloak:8080
    }

    handle {
        # CSP de la SPA únicamente: excluir /identity/* porque Keycloak tiene
        # sus propias reglas de login, formularios y recursos embebidos.
        header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:"
        reverse_proxy web:80
    }
}
