# Copiar a .env.qa y reemplazar TODOS los secretos antes de levantar QA.
# Nunca subir .env.qa al repositorio.

POSTGRES_DB=pmgm
POSTGRES_USER=pmgm_app
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_LARGO_Y_ALEATORIO

MINIO_ACCESS_KEY=pmgm_qa_storage
MINIO_SECRET_KEY=CAMBIAR_SECRETO_LARGO_Y_ALEATORIO
S3_REGION=us-east-1
S3_BUCKET=pmgm-documents
DOCUMENT_MAX_UPLOAD_BYTES=52428800

# El web queda escuchando sólo en localhost por defecto.
# Un reverse proxy TLS del host debe publicar HTTPS hacia Internet/LAN.
PMGM_BIND_ADDRESS=127.0.0.1
PMGM_HTTP_PORT=8081

# QA debe usar VITE_USE_MOCKS=false (fijado en docker-compose.qa.yml).
# Para probar flujos autenticados se requiere un proveedor OIDC de pruebas.
OIDC_AUTHORITY=
OIDC_API_AUDIENCE=pmgm-api
OIDC_CLIENT_ID=
OIDC_SCOPE=openid profile

# Conveniente en QA. En producción la estrategia de migraciones será controlada por release.
APPLY_MIGRATIONS_ON_STARTUP=true
